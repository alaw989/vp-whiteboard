{
  "extends": "./.nuxt/tsconfig.json",
  "exclude": [
    "./e2e",
    "./playwright.config.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "#imports": [
        "./.nuxt/imports.d.ts"
      ],
      "~/*": [
        "./*"
      ],
      "@/*": [
        "./*"
      ],
      "~~/*": [
        "./*"
      ],
      "#components": [
        "./.nuxt/components"
      ]
    }
  }
}
