# Nuxt frontend env (the backend is Laravel — see root .env.example)
# Copy to frontend/.env and adjust if your local ports differ.

# Laravel API URL. Local dev: Laravel on :8000 (php artisan serve).
NUXT_PUBLIC_LARAVEL_URL=http://localhost:8000

# Yjs WebSocket relay (npm run dev:ws). Default port 3001.
WS_PORT=3001
NUXT_PUBLIC_WS_URL=ws://localhost:3001

# This Nuxt server's public URL.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
